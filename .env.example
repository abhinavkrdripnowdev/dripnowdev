# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api

# Browser key: restrict to Maps JavaScript API and your website HTTP referrers.
# Keep the separate server Geocoding key only in backend/.env.
VITE_MAPS_PROVIDER=google
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Datadog Browser Log Management Configuration
VITE_DATADOG_CLIENT_TOKEN=pub_datadog_client_token_sample
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_SERVICE=dripnow-frontend-api
VITE_DATADOG_ENV=development
VITE_ENABLE_DATADOG_LOGS=true

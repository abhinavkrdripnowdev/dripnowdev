{
  "name": "dripnow-backend",
  "version": "1.0.0",
  "description": "DripNow E-Commerce Platform \u2014 API Server",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "migrate": "npm run build && node scripts/migrate.cjs",
    "migrate:status": "npm run build && node scripts/migration-status.cjs",
    "seed": "npm run build && node database/seeds/categories.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "db:create": "node scripts/setup-mysql.cjs",
    "admin:bootstrap": "npm run build && node scripts/bootstrap-admin.cjs",
    "jobs": "npm run build && node dist/jobs/maintenance.js",
    "generate:postman": "node generate_postman.js"
  },
  "keywords": [],
  "author": "DripNow Dev",
  "license": "MIT",
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.5",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  }
}

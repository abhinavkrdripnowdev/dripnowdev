# Environment Variables — Backend

# ─── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dripnow

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_access
JWT_REFRESH_SECRET=change_this_to_a_long_random_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Email (Nodemailer) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="DripNow <noreply@dripnow.com>"

# ─── OTP ─────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── Password Reset ──────────────────────────────────────
RESET_TOKEN_EXPIRES_IN_MINUTES=15

# SMS: mock is development only; use twilio in production
SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Razorpay (set test credentials before live credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Nominatim-compatible hosted/self-hosted geocoding provider
MAPS_GEOCODING_URL=
MAPS_USER_AGENT=DripNow/1.0 (set your operator contact)

# Payout execution: manual is development-only; production uses a secured provider adapter
PAYOUT_PROVIDER=manual
# PAYOUT_API_URL=https://payout-provider.example/transfers
# PAYOUT_API_KEY=

# Optional push gateway accepting {tokens,title,message,data}
# PUSH_API_URL=
# PUSH_API_KEY=
